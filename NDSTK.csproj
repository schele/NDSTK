<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
    <!--
      This project sits at the repository root, so the SDK's default globs would otherwise pull
      the sibling projects' sources - and their generated obj/ files - into the web assembly,
      which fails with duplicate assembly attributes. DefaultItemExcludes covers every default
      item glob at once (Compile, Content, None, EmbeddedResource), so no individual Remove is
      needed. Any further project added beside this one has to be listed here too.

      The two trailing wildcards are not redundant with the named folders above them, and are the
      more important half. A named exclusion only protects a project that still EXISTS: when the
      cookie scanner's four projects were extracted into the Esatto.Packages repository, deleting
      their sources and dropping them from this list left their bin\ and obj\ behind - untracked,
      so `git rm` never touched them and .gitignore hid them from `git status` - and the globs
      promptly pulled those generated AssemblyInfo.cs files in. The build failed with a wall of
      duplicate-attribute errors naming projects that no longer existed.

      It happened twice, because an IDE holding a stale solution model rebuilds the deleted
      projects and recreates the folders after they are cleaned. Excluding every sibling bin\ and
      obj\ by shape rather than by name ends the whole class: no first-level build-output folder
      can reach this assembly, whether or not a project still owns it. Nothing tracked lives under
      such a path.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);NDSTK.Tests\**;NDSTK.Domain\**;*\bin\**;*\obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Esatto.Umbraco.Backoffice.ContentTreeDragAndDrop" Version="2.0.0" />
    <PackageReference Include="Esatto.Umbraco.Backoffice.CookieBanner" Version="1.1.1" />
    <!--
      The cookie scanner's merge endpoint, which used to be CookieScan\ in this repository. Brings
      Esatto.CookieScan.Core 1.1.0 with it, transitively. Nothing here references Core directly, and
      nothing should: the endpoint is the whole site-side surface.

      1.1.0 rather than 1.0.0, and not for a feature: 1.0.0 shipped declaring a dependency on
      Esatto.CookieScan.Core 1.0.0, which was never actually pushed to nuget.org. Restoring it
      raised NU1603 and silently floated Core up to 1.1.0 - a resolution that worked, but only
      because NuGet was guessing. 1.1.0 of this package names a Core version that exists.

      The scan itself never runs here. It drives a headless browser on whichever machine runs
      esatto-cookiescan-ui.exe and posts its findings to this endpoint, which appends them to the
      cookie policy page as a draft. Emailing a report is likewise a function of that tool and its
      SMTP settings, not of this site. -->
    <PackageReference Include="Esatto.Umbraco.Backoffice.CookieScan" Version="1.1.0" />
    <PackageReference Include="Esatto.Umbraco.Backoffice.DictionaryFilterValues" Version="1.0.3" />
    <PackageReference Include="Esatto.Umbraco.Backoffice.MediaTreeDragAndDrop" Version="1.0.1" />
    <PackageReference Include="Umbraco.Cms" Version="18.1.1" />
    <PackageReference Include="Umbraco.Community.BlockPreview" Version="6.0.0" />
    <PackageReference Include="uSync" Version="18.1.2" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms.
      Default mirrors prior behaviour introduced in https://github.com/umbraco/Umbraco-CMS/pull/11276: enabled unless building on macOS without an explicit RuntimeIdentifier.
      To override:
        * Build/publish:  dotnet publish -p:UmbracoUseAppLocalIcu=false
        * Post-publish:   edit System.Globalization.AppLocalIcu in the published *.runtimeconfig.json
      Note: DOTNET_SYSTEM_GLOBALIZATION_APPLOCALICU is only honored when AppLocalIcu is absent from runtimeconfig.json
      (verified on .NET 10) — the general .NET 9 env-var-precedence rule does not apply to this knob, since it is
      resolved by the native host before the CLR boots. Use one of the two override paths above instead.
      UmbracoAppLocalIcuVersion drives both the Microsoft.ICU.ICU4C.Runtime package version and the AppLocalIcu
      runtime config value below, so the two cannot drift apart.
    -->
    <UmbracoUseAppLocalIcu Condition="'$(UmbracoUseAppLocalIcu)' == '' and ($(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx'))))">true</UmbracoUseAppLocalIcu>
    <UmbracoUseAppLocalIcu Condition="'$(UmbracoUseAppLocalIcu)' == ''">false</UmbracoUseAppLocalIcu>
    <UmbracoAppLocalIcuVersion Condition="'$(UmbracoAppLocalIcuVersion)' == ''">72.1.0.3</UmbracoAppLocalIcuVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UmbracoUseAppLocalIcu)' == 'true'">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="$(UmbracoAppLocalIcuVersion)" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="$(UmbracoAppLocalIcuVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="NDSTK.Domain\NDSTK.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Web SDK treats every root .json file as Content, and Content is published - .gitignore has
      no say in what a publish copies. This file holds the development scanner secret and the
      unattended-install admin credentials, so a default publish put both on the production server
      and could overwrite a secrets file that server already had. Still copied to the output
      directory, which is where a local run reads it from; only the publish is blocked.
    -->
    <Content Update="appsettings.Secrets.json" CopyToPublishDirectory="Never" />
  </ItemGroup>


  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>


</Project>
