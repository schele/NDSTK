{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "UseHttps": true,
        "Id": "95a9d91b-60d6-49b9-ac7c-0e7473a8d70f",
        // one.com's outgoing mail server. The mailbox password is deliberately absent: it belongs
        // in appsettings.Secrets.json, which is gitignored, under the same
        // Umbraco:CMS:Global:Smtp:Password path. PickupDirectoryLocation must stay unset here -
        // Umbraco's EmailSender checks it *before* SMTP, so setting it in production would write
        // every mail to disk instead of sending it.
        "Smtp": {
          "From": "info@ndstk.se",
          "Host": "send.one.com",
          "Port": 465,
          "SecureSocketOptions": "SslOnConnect",
          "Username": "info@ndstk.se"
        }
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        },
        "Error404Collection": [
          {
            "Culture": "default",
            "ContentKey": "c0117e17-0000-4000-8000-000000000005"
          }
        ]
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Runtime": {
        "Mode": "Production"
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://ndstk.se/"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "dbnizsW8Bz3jyZbbrplH9s8P8OptZojBes/xcrMecDyimMQPAI2Bs\u002BAMkzAqv\u002B5fANI575/ptA\u002BX8zBq8mvVCg=="
      },
      "RequestHandler": {
        "AddTrailingSlash": false,
        "ConvertUrlsToAscii": "try",
        "EnableDefaultCharReplacements": true,
        "UserDefinedCharCollection": [
          {
            "Char": "\u00E5",
            "Replacement": "a"
          },
          {
            "Char": "\u00E4",
            "Replacement": "a"
          },
          {
            "Char": "\u00F6",
            "Replacement": "o"
          },
          {
            "Char": "\u00C5",
            "Replacement": "a"
          },
          {
            "Char": "\u00C4",
            "Replacement": "a"
          },
          {
            "Char": "\u00D6",
            "Replacement": "o"
          },
          {
            "Char": "\u00E9",
            "Replacement": "e"
          },
          {
            "Char": "\u00C9",
            "Replacement": "e"
          }
        ]
      }
    }
  },
  "Esatto": {
    "CookieBanner": {
      "CookieName": "ndstk-consent"
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  }
}