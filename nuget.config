<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    TEMPORARY, and the one thing to undo when the scanner packages go public.

    Esatto.Umbraco.Backoffice.CookieScan and Esatto.CookieScan.Core were extracted out of this
    repository into the Esatto.Packages mono-repo and are not on nuget.org yet. Until they are,
    this site builds against the .local-feed copies that `dotnet pack` puts there, at the
    MinVer preview version an untagged build produces.

    To finish the move:
      1. In c:\src\Esatto.Packages, tag and pack:
           git tag Esatto.CookieScan.Core-1.0.0
           git tag Esatto.Umbraco.Backoffice.CookieScan-1.0.0
           ./push-nuget.ps1 -Project .\Esatto.CookieScan.Core\Esatto.CookieScan.Core.csproj
           ./push-nuget.ps1 -Project .\Esatto.Umbraco.Backoffice.CookieScan\Esatto.Umbraco.Backoffice.CookieScan.csproj
      2. Point the two PackageReference versions in NDSTK.csproj at 1.0.0.
      3. Delete this file. nuget.org and the Azure feed are both configured machine-wide, so
         without it this repository resolves everything the way it did before.
  -->
  <packageSources>
    <add key="esatto-local" value="c:\src\Esatto.Packages\.local-feed" />
  </packageSources>

</configuration>
