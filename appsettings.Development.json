{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // Debug for our own code only, so a reminder run that finds nothing is still visible
        // locally without drowning the log in framework noise.
        "NDSTK": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "UseHttps": false,
        // Locally, every mail is written to disk as an .eml file instead of being sent, so the
        // whole registration and reminder flow is testable without the live mailbox password.
        // Umbraco's EmailSender checks PickupDirectoryLocation before SMTP, so this wins outright.
        // The folder is under umbraco/Logs, which .gitignore already excludes - test mail can
        // never be committed by accident.
        "Smtp": {
          "From": "info@ndstk.se",
          "DeliveryMethod": "SpecifiedPickupDirectory",
          "PickupDirectoryLocation": "umbraco/Logs/Mail"
        }
      },
      "Runtime": {
        "Mode": "Development"
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeAuto"
      },
      "Hosting": {
        "Debug": true
      }
    }
  },
  "uSync": {
    "Settings": {
      "ExportOnSave": "None"
    }
  }
}
