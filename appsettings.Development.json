{
  "$schema": "appsettings-schema.json",
  // Puts the "Nollställ testdata" buttons on the Medlemmar dashboard. Only ever set here, in the
  // file a deployment does not ship, so the reset cannot appear on a site with real members even if
  // that site is started in the Development environment by mistake.
  "NDSTK": {
    "AllowTestDataReset": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // Debug for our own code only, so a reminder run that finds nothing is still visible
        // locally without drowning the log in framework noise.
        "NDSTK": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "UseHttps": false,
        // Locally, every mail is written to disk as an .eml file instead of being sent, so the
        // whole registration and reminder flow is testable without the live mailbox password.
        // Umbraco's EmailSender checks PickupDirectoryLocation before SMTP, so this wins outright.
        // The folder is under umbraco/Logs, which .gitignore already excludes - test mail can
        // never be committed by accident.
        "Smtp": {
          "From": "info@ndstk.se",
          "DeliveryMethod": "SpecifiedPickupDirectory",
          "PickupDirectoryLocation": "umbraco/Logs/Mail"
        }
      },
      "Runtime": {
        "Mode": "Development"
      },
      // Locally the links in mail have to point at the machine sending them. appsettings.json holds
      // the live URL, and no domain is bound to the site, so without this override a verification
      // mail written to umbraco/Logs/Mail during a local test links to https://ndstk.se/ - a page
      // that cannot activate the account that was just created here. Matches the sslPort in
      // Properties/launchSettings.json.
      "WebRouting": {
        "UmbracoApplicationUrl": "https://localhost:44351/"
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeAuto"
      },
      "Hosting": {
        "Debug": true
      }
    }
  },
  "uSync": {
    "Settings": {
      "ExportOnSave": "None"
    }
  }
}
