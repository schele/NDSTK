{
  "$schema": "appsettings-schema.json",
  // Turns on the cookie scanner's API user in production. The seeder itself is not
  // environment-gated (Program.cs runs it on every boot); this flag is the switch, and it lived
  // only in appsettings.Development.json - so production booted, skipped the seeder, and the
  // scanner's token request came back invalid_client because OpenIddict had never been told about
  // the client id.
  //
  // The secret deliberately is NOT here. It belongs on the server, either as the environment
  // variable NDSTK__CookieScanApiUser__ClientSecret or in an untracked appsettings.Secrets.json
  // beside the deployed app. Until one of those is set the seeder logs a warning naming the
  // setting and does nothing else, so deploying this file ahead of the secret is safe.
  "NDSTK": {
    "CookieScanApiUser": {
      "Enabled": true,
      "ClientId": "cookie-scanner"
    }
  }
}
