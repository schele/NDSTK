{
  "$schema": "../../umbraco-package-schema.json",
  "id": "NDSTK.MemberAdmin",
  "name": "NDSTK Member Administration",
  "version": "1.0.0",
  "extensions": [
    {
      "type": "localization",
      "alias": "NDSTK.MemberAdmin.Localization.En",
      "name": "NDSTK Member Administration - English",
      "meta": { "culture": "en" },
      "js": "/App_Plugins/NDSTK.MemberAdmin/lang/en.js"
    },
    {
      "type": "localization",
      "alias": "NDSTK.MemberAdmin.Localization.Sv",
      "name": "NDSTK Member Administration - Swedish",
      "meta": { "culture": "sv" },
      "js": "/App_Plugins/NDSTK.MemberAdmin/lang/sv.js"
    },
    {
      "type": "dashboard",
      "alias": "NDSTK.MemberAdmin.Dashboard",
      "name": "Members",
      "element": "/App_Plugins/NDSTK.MemberAdmin/members-dashboard.js",
      "elementName": "ndstk-members-dashboard",
      "meta": { "label": "#ndstk_members", "pathname": "ndstk-members", "weight": 100 },
      "conditions": [{ "alias": "Umb.Condition.SectionAlias", "match": "Umb.Section.Members" }]
    },
    {
      "type": "workspaceView",
      "alias": "NDSTK.MemberAdmin.ClassRoster",
      "name": "Participants",
      "element": "/App_Plugins/NDSTK.MemberAdmin/class-roster.js",
      "elementName": "ndstk-class-roster",
      "meta": { "label": "#ndstk_roster", "pathname": "participants", "icon": "icon-users", "weight": 200 },
      "conditions": [
        { "alias": "Umb.Condition.WorkspaceAlias", "match": "Umb.Workspace.Document" },
        { "alias": "Umb.Condition.WorkspaceContentTypeAlias", "match": "trainingClass" }
      ]
    }
  ]
}
