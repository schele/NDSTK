@using NDSTK.Booking.Domain
@using NDSTK.Booking.Web
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Root.cshtml";

    var portal = ViewData["MemberPortal"] as MemberPortalViewModel;

    string Kr(int ore) => (ore / 100).ToString("N0", new System.Globalization.CultureInfo("sv-SE"));
    string When(DateTime utc) => SwedishTime.ToSwedish(utc).ToString("dddd d MMMM HH:mm",
        new System.Globalization.CultureInfo("sv-SE"));
}

@* Takes the sidebar over from Root.cshtml. The member's own membership and bookings belong in the
   right column here; the boxes it replaces - "Medlem" and the "Bli medlem" call to action - are
   either redundant or actively wrong for somebody who is already signed in. *@
@section Sidebar {
    @if (portal is not null)
    {
        <div class="widget">
            <h3>Mitt medlemskap</h3>

            @if (portal.Email is { Length: > 0 } email)
            {
                @* The email is also the login name, so this is the identifier worth confirming -
                   particularly on a shared machine. Wrapped anywhere, because a long address in a
                   narrow column would otherwise push the box wider than its neighbours. *@
                <p class="widget__member">Inloggad som <strong>@email</strong></p>
            }

            @if (portal.Membership.IsValid)
            {
                <p class="form-notice form-notice--ok">
                    Årsavgiften är betald@(portal.Membership.PaidUntil is { } until
                        ? $" till och med {until:yyyy-MM-dd}" : "").
                </p>
            }
            else if (portal.Membership.HasLapsed)
            {
                <p class="form-notice form-notice--error" role="status">
                    Ditt medlemskap gick ut @(portal.Membership.PaidUntil?.ToString("yyyy-MM-dd")).
                    Årsavgiften på @Kr(portal.Prices.MembershipFeeOre) kr förnyas automatiskt när du
                    bokar din nästa träning.
                </p>
            }
            else
            {
                <p class="form-notice">
                    Årsavgiften på @Kr(portal.Prices.MembershipFeeOre) kr läggs till när du bokar
                    din nästa träning.
                </p>
            }

            @* Priced per child: the welcome price is once per child, so on a family account two
               children routinely have two different next-class prices. *@
            @foreach (var child in portal.Children)
            {
                var welcomeNote = child.FirstClassAvailable ? " (välkomstpris)" : string.Empty;
                <p>
                    Nästa träning för <strong>@child.FullName</strong> kostar
                    <strong>@Kr(portal.NextClassFeeOreFor(child)) kr</strong>@welcomeNote.
                </p>
            }

            @if (portal.UnspentCredits > 0)
            {
                <p class="form-notice form-notice--ok">
                    Du har <strong>@portal.UnspentCredits</strong>
                    @(portal.UnspentCredits == 1 ? "tillgodoträning" : "tillgodoträningar")
                    att använda.
                </p>
            }

        </div>

        @* Bookings first: what a member comes back to the portal for is what they have coming up.
           Managing children is occasional, so it sits below. *@
        @await Html.PartialAsync("MemberBookings", new MemberBookingsPanel(portal.MyBookings, AllowCancel: true))

        @await Html.PartialAsync("MemberChildren", portal)

        @* Its own box, and last: signing out is not part of reading your membership or your
           bookings, and putting it after them keeps it out of the way of what the page is for.
           A POST, so a prefetched URL or a third-party image cannot sign somebody out. *@
        <div class="widget widget--action">
            @using (Html.BeginUmbracoForm<LoginSurfaceController>(
                nameof(LoginSurfaceController.Logout)))
            {
                <button type="submit" class="btn-secondary">Logga ut</button>
            }
        </div>
    }
}

<div class="content-blocks">
    <section class="hero">
        <div class="hero-content">
            <h1>@(Model.Value<string>("heading").IfNullOrWhiteSpace(Model.Name))</h1>
            <p>@(Model.Value<string>("description"))</p>
        </div>
    </section>

    @if (portal is null)
    {
        <article class="post">
            <p class="form-notice form-notice--error" role="alert">
                Vi kunde inte läsa dina uppgifter. Prova att logga in igen.
            </p>
        </article>
    }
    else
    {
        @if (TempData["BookingMessage"] is string bookingMessage)
        {
            <div class="form-notice form-notice--ok" role="status">@bookingMessage</div>
        }
        @if (TempData["BookingError"] is string bookingError)
        {
            <div class="form-notice form-notice--error" role="alert">@bookingError</div>
        }

        @* Reminder banner. Portal-only by design, and a pure read of the bookings list, so the two
           can never disagree about what is coming up. *@
        @foreach (var reminder in portal.ReminderBookings)
        {
            <div class="reminder-banner" role="status">
                <strong>Påminnelse:</strong>
                @(reminder.Class?.Title ?? "Din träning") börjar @When(reminder.ClassStartUtc).
                @if (reminder.Class?.Location is { Length: > 0 } place)
                {
                    <span>Plats: @place.</span>
                }
            </div>
        }

        <article class="post">
            <h2>Boka träning</h2>
            @if (portal.UpcomingClasses.Count == 0)
            {
                <p>Inga träningar är upplagda just nu. Håll utkik!</p>
            }
            else
            {
                <ul class="class-list">
                    @foreach (var bookable in portal.UpcomingClasses)
                    {
                        <li class="class-list__item">
                            <div class="class-list__head">
                                <span class="class-list__title">@bookable.Class.Title</span>
                                <span class="class-list__places">
                                    @if (bookable.IsFull)
                                    {
                                        <span class="tag tag--full">Fullbokad</span>
                                    }
                                    else
                                    {
                                        @* The club's "max x players" made visible to the member. *@
                                        <text>@bookable.RemainingPlaces av @bookable.Class.Capacity platser kvar</text>
                                    }
                                </span>
                            </div>
                            <div class="class-list__meta">
                                @When(bookable.Class.StartUtc)
                                · @bookable.Class.DurationMinutes min
                                @if (bookable.Class.Instructor is { Length: > 0 } coach)
                                {
                                    <text>· @coach </text>
                                }
                                @if (bookable.Class.Location is { Length: > 0 } where)
                                {
                                    <text>· @where</text>
                                }
                            </div>
                            @if (bookable.Class.Description is { Length: > 0 } about)
                            {
                                <p class="class-list__about">@about</p>
                            }
                            <div class="class-list__actions">
                                @{
                                    @* Which of my children are already on this class, named. On a
                                       family account "Redan bokad" alone is ambiguous - it has to
                                       say who. *@
                                    var bookedNames = portal.Children
                                        .Where(child => bookable.BookedParticipantKeys.Contains(child.Key))
                                        .Select(child => child.FirstName)
                                        .ToArray();

                                    var choices = portal.Children
                                        .Where(child => bookable.BookableParticipantKeys.Contains(child.Key))
                                        .ToArray();
                                }

                                @if (bookedNames.Length > 0)
                                {
                                    @* A label, not a filled tag: this states a fact about the
                                       class, it is not something to click. Same treatment as
                                       "Tillgodoträning" in the bookings list. *@
                                    <span class="tag tag--label">
                                        Bokad: @string.Join(", ", bookedNames)
                                    </span>
                                }

                                @if (bookable.CanBook && choices.Length > 0)
                                {
                                    @* Two separate forms rather than one with a toggle: each button
                                       posts exactly what it says it does, so there is no state to
                                       get out of step with the label. *@
                                    using (Html.BeginUmbracoForm<BookingSurfaceController>(
                                        nameof(BookingSurfaceController.Book)))
                                    {
                                        <input type="hidden" name="classKey" value="@bookable.Class.Key" />

                                        @if (choices.Length == 1)
                                        {
                                            @* One child left to book: no question to ask, and the
                                               price is known, so it goes on the button. *@
                                            <input type="hidden" name="participantKey" value="@choices[0].Key" />
                                            <button type="submit" class="btn-primary"
                                                    disabled="@(choices[0].IsComplete ? null : "disabled")">
                                                Boka @choices[0].FirstName —
                                                @Kr(portal.NextBookingTotalOreFor(choices[0])) kr
                                            </button>
                                        }
                                        else
                                        {
                                            @* Several children, and the price depends on which one -
                                               so each option carries its own. One figure on the
                                               button would be wrong for at least one child. *@
                                            <label class="visually-hidden" for="child-@bookable.Class.Key">
                                                Välj barn
                                            </label>
                                            <select id="child-@bookable.Class.Key" name="participantKey"
                                                    class="class-list__child-picker">
                                                @foreach (var child in choices)
                                                {
                                                    <option value="@child.Key"
                                                            disabled="@(child.IsComplete ? null : "disabled")">
                                                        @child.FullName —
                                                        @Kr(portal.NextBookingTotalOreFor(child)) kr
                                                        @(child.IsComplete ? string.Empty : " (fyll i födelsedatum)")
                                                    </option>
                                                }
                                            </select>
                                            <button type="submit" class="btn-primary">Boka</button>
                                        }
                                    }

                                    @if (portal.UnspentCredits > 0)
                                    {
                                        @* Its own row. Side by side with the paying button - each
                                           with its own child picker - the two read as one confusing
                                           control rather than two alternatives. *@
                                        using (Html.BeginUmbracoForm<BookingSurfaceController>(
                                            nameof(BookingSurfaceController.Book), null,
                                            new { @class = "class-list__credit" }))
                                        {
                                            <input type="hidden" name="classKey" value="@bookable.Class.Key" />
                                            <input type="hidden" name="useCredit" value="true" />

                                            @if (choices.Length == 1)
                                            {
                                                <input type="hidden" name="participantKey" value="@choices[0].Key" />
                                            }
                                            else
                                            {
                                                <label class="visually-hidden" for="credit-child-@bookable.Class.Key">
                                                    Välj barn
                                                </label>
                                                <select id="credit-child-@bookable.Class.Key" name="participantKey"
                                                        class="class-list__child-picker">
                                                    @foreach (var child in choices)
                                                    {
                                                        <option value="@child.Key"
                                                                disabled="@(child.IsComplete ? null : "disabled")">
                                                            @child.FullName
                                                        </option>
                                                    }
                                                </select>
                                            }

                                            @* Secondary, not a link: it is an equal alternative to
                                               paying, so it should look like a choice rather than a
                                               footnote - just not competing with the yellow. *@
                                            <button type="submit" class="btn-secondary">
                                                Boka med tillgodoträning
                                            </button>
                                        }
                                    }
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </article>
    }
</div>
