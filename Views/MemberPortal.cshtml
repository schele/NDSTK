@using NDSTK.Booking.Domain
@using NDSTK.Booking.Web
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Root.cshtml";

    var portal = ViewData["MemberPortal"] as MemberPortalViewModel;

    string Kr(int ore) => (ore / 100).ToString("N0", new System.Globalization.CultureInfo("sv-SE"));
    string When(DateTime utc) => SwedishTime.ToSwedish(utc).ToString("dddd d MMMM HH:mm",
        new System.Globalization.CultureInfo("sv-SE"));
}

@* Takes the sidebar over from Root.cshtml. The member's own membership and bookings belong in the
   right column here; the boxes it replaces - "Medlem" and the "Bli medlem" call to action - are
   either redundant or actively wrong for somebody who is already signed in. *@
@section Sidebar {
    @if (portal is not null)
    {
        <div class="widget">
            <h3>Mitt medlemskap</h3>

            @if (portal.Email is { Length: > 0 } email)
            {
                @* The email is also the login name, so this is the identifier worth confirming -
                   particularly on a shared machine. Wrapped anywhere, because a long address in a
                   narrow column would otherwise push the box wider than its neighbours. *@
                <p class="widget__member">Inloggad som <strong>@email</strong></p>
            }

            @* One notice, not two. What kind of account this is and what the årsavgift is doing are
               the same fact from a member's point of view - two boxes said it twice and made the box
               look like it was reporting two problems.

               The colour still carries the membership verdict, because that is the half that has
               one: green when it is paid, red when it has run out, plain when it has never been
               paid. The account type leads, since it is what the sentence after it depends on. *@
            @{
                var membershipClass = portal.Membership.IsValid
                    ? "form-notice form-notice--ok"
                    : portal.Membership.HasLapsed
                        ? "form-notice form-notice--error"
                        : "form-notice";

                // A family account owes the supplement alongside the årsavgift on renewal, so the
                // figure quoted here has to be both - see Pricing.Quote. Written as a sum rather
                // than a total, so a member can see which part is the family bit.
                var feeText = portal.Membership.IsFamilyAccount
                    ? $"{Kr(portal.Prices.MembershipFeeOre)} + {Kr(portal.Prices.FamilyFeeOre)} kr"
                    : $"{Kr(portal.Prices.MembershipFeeOre)} kr";
            }
            <p class="@membershipClass" role="status">
                @if (portal.Membership.IsFamilyAccount)
                {
                    <text><strong>Familjekonto</strong> – flera syskon på samma inloggning.</text>
                }
                else
                {
                    <text><strong>Solokonto</strong> – plats för ett barn.</text>
                }

                @if (portal.Membership.IsValid)
                {
                    <text>
                        Årsavgiften är betald@(portal.Membership.PaidUntil is { } until
                            ? $" till och med {until:yyyy-MM-dd}" : "").
                    </text>
                }
                else if (portal.Membership.HasLapsed)
                {
                    <text>
                        Medlemskapet gick ut @(portal.Membership.PaidUntil?.ToString("yyyy-MM-dd")).
                        Årsavgiften på @feeText förnyas automatiskt när du bokar din nästa träning.
                    </text>
                }
                else
                {
                    <text>
                        Årsavgiften på @feeText läggs till när du bokar din nästa träning.
                    </text>
                }
            </p>

            @* Priced per child: the welcome price is once per child, so on a family account two
               children routinely have two different next-class prices.

               Not shown at all while the account holds a credit. The paying option is not offered
               in that state either, so a price nobody is about to be charged is just a number to
               misread. The lapsed-membership notice above still says the årsavgift is coming, which
               is the one charge a credit does not cover. *@
            @if (portal.UnspentCredits == 0)
            {
                foreach (var child in portal.Children)
                {
                    var welcomeNote = child.FirstClassAvailable ? " (välkomstpris)" : string.Empty;
                    <p>
                        Nästa träning för <strong>@child.FullName</strong> kostar
                        <strong>@Kr(portal.NextClassFeeOreFor(child)) kr</strong>@welcomeNote.
                    </p>
                }
            }
            else
            {
                <p class="form-notice form-notice--ok">
                    Du har <strong>@portal.UnspentCredits</strong>
                    @(portal.UnspentCredits == 1 ? "tillgodoträning" : "tillgodoträningar")
                    att använda.
                </p>
            }

        </div>

        @* Bookings first: what a member comes back to the portal for is what they have coming up.
           Managing children is occasional, so it sits below. *@
        @await Html.PartialAsync("MemberBookings", new MemberBookingsPanel(portal.MyBookings, AllowCancel: true, portal.CancellationDeadlineHours))

        @await Html.PartialAsync("MemberChildren", portal)

        @* Its own box, and last: signing out is not part of reading your membership or your
           bookings, and putting it after them keeps it out of the way of what the page is for.
           A POST, so a prefetched URL or a third-party image cannot sign somebody out. *@
        <div class="widget widget--action">
            @using (Html.BeginUmbracoForm<LoginSurfaceController>(
                nameof(LoginSurfaceController.Logout)))
            {
                <button type="submit" class="btn-secondary">Logga ut</button>
            }
        </div>
    }
}

<div class="content-blocks">
    <section class="hero">
        <div class="hero-content">
            <h1>@(Model.Value<string>("heading").IfNullOrWhiteSpace(Model.Name))</h1>
            <p>@(Model.Value<string>("description"))</p>
        </div>
    </section>

    @if (portal is null)
    {
        <article class="post">
            <p class="form-notice form-notice--error" role="alert">
                Vi kunde inte läsa dina uppgifter. Prova att logga in igen.
            </p>
        </article>
    }
    else
    {
        @if (TempData["BookingMessage"] is string bookingMessage)
        {
            <div class="form-notice form-notice--ok" role="status">@bookingMessage</div>
        }
        @if (TempData["BookingError"] is string bookingError)
        {
            <div class="form-notice form-notice--error" role="alert">@bookingError</div>
        }

        @* Reminder banner. Portal-only by design, and a pure read of the bookings list, so the two
           can never disagree about what is coming up. *@
        @foreach (var reminder in portal.ReminderBookings)
        {
            <div class="reminder-banner" role="status">
                <strong>Påminnelse:</strong>
                @(reminder.Class?.Title ?? "Din träning") börjar @When(reminder.ClassStartUtc).
                @if (reminder.Class is { Location.Length: > 0 } soon)
                {
                    <span>Plats: @await Html.PartialAsync("ClassLocation", soon).</span>
                }
            </div>
        }

        <article class="post">
            <h2>Boka träning</h2>
            @if (portal.ClassesToOffer.Count == 0)
            {
                @* Two different nothings, and telling a member "inga träningar är upplagda" when
                   they are booked on every one of them would read as though the club had cancelled
                   the term. *@
                @if (portal.UpcomingClasses.Count == 0)
                {
                    <p>Inga träningar är upplagda just nu. Håll utkik!</p>
                }
                else
                {
                    <p>
                        Du är bokad på alla träningar som är upplagda just nu. De finns under
                        <strong>Mina bokningar</strong>.
                    </p>
                }
            }
            else
            {
                @* A member with no child on the account gets every class rendered with nothing
                   under it: booking needs somebody to book, so the buttons below are all skipped
                   and the list reads as broken rather than as waiting on something.

                   Said once, above the list, rather than in each empty row - it is a fact about the
                   account and not about any one class, and a term with ten classes would repeat it
                   ten times. The list itself stays: seeing what is on offer is the reason to add a
                   child in the first place.

                   "under Mina barn" rather than "ovan": that box is in the sidebar while this is the
                   main column, so any directional word is wrong at desktop width - and wrong the
                   other way round once the columns stack. *@
                @if (portal.Children.Count == 0)
                {
                    <p class="form-notice">
                        Du behöver lägga till ett barn innan du kan boka en träning. Det gör du
                        under <strong>Mina barn</strong>.
                    </p>
                }

                <ul class="class-list">
                    @foreach (var bookable in portal.ClassesToOffer)
                    {
                        <li class="class-list__item">
                            <div class="class-list__head">
                                <span class="class-list__title">@bookable.Class.Title</span>
                                <span class="class-list__places">
                                    @if (bookable.IsFull)
                                    {
                                        <span class="tag tag--full">Fullbokad</span>
                                    }
                                    else
                                    {
                                        @* The club's "max x players" made visible to the member. *@
                                        <text>@bookable.RemainingPlaces av @bookable.Class.Capacity platser kvar</text>
                                    }
                                </span>
                            </div>
                            <div class="class-list__meta">
                                @When(bookable.Class.StartUtc)
                                · @bookable.Class.DurationMinutes min
                                @if (bookable.Class.Instructor is { } coach)
                                {
                                    <text>· </text>
                                    @await Html.PartialAsync("InstructorName", coach)
                                }
                                @if (bookable.Class.Location is { Length: > 0 })
                                {
                                    <text>· </text>
                                    @await Html.PartialAsync("ClassLocation", bookable.Class)
                                }
                            </div>
                            @if (bookable.Class.Description is { Length: > 0 } about)
                            {
                                <p class="class-list__about">@about</p>
                            }
                            <div class="class-list__actions">
                                @{
                                    @* Only the children who can still be booked onto this class.
                                       There is deliberately no "Bokad: Steve" label any more: a
                                       class only appears here while somebody can still be booked,
                                       so who is already on it is answered by Mina bokningar, and
                                       repeating it beside a button that names the child who *can*
                                       book was one fact too many. *@
                                    var choices = portal.Children
                                        .Where(child => bookable.BookableParticipantKeys.Contains(child.Key))
                                        .ToArray();
                                }

                                @if (bookable.CanBook && choices.Length > 0)
                                {
                                    @* A credit in hand beats paying, so while the account has one
                                       the paying option is not offered at all. Showing both invites
                                       a member to pay for something they have already paid for.

                                       Credits belong to the account, not the child, and there may
                                       be fewer of them than children. That resolves itself: after
                                       spending the last one the page re-renders with none left and
                                       the paying option comes back for whoever is still unbooked.

                                       Two separate forms rather than one with a toggle: each button
                                       posts exactly what it says it does, so there is no state to
                                       get out of step with the label. *@
                                    if (portal.UnspentCredits == 0)
                                    {
                                    using (Html.BeginUmbracoForm<BookingSurfaceController>(
                                        nameof(BookingSurfaceController.Book), null,
                                        new { @class = "class-list__book" }))
                                    {
                                        <input type="hidden" name="classKey" value="@bookable.Class.Key" />

                                        @if (choices.Length == 1)
                                        {
                                            @* One child left to book: no question to ask, and the
                                               price is known, so it goes on the button. *@
                                            <input type="hidden" name="participantKey" value="@choices[0].Key" />
                                            <button type="submit" class="btn-primary"
                                                    disabled="@(choices[0].IsComplete ? null : "disabled")">
                                                Boka @choices[0].FirstName —
                                                @Kr(portal.NextBookingTotalOreFor(choices[0])) kr
                                            </button>
                                        }
                                        else
                                        {
                                            @* Several children, and the price depends on which one -
                                               so each option carries its own. One figure on the
                                               button would be wrong for at least one child. *@
                                            <label class="visually-hidden" for="child-@bookable.Class.Key">
                                                Välj barn
                                            </label>
                                            <select id="child-@bookable.Class.Key" name="participantKey"
                                                    class="class-list__child-picker">
                                                @foreach (var child in choices)
                                                {
                                                    <option value="@child.Key"
                                                            disabled="@(child.IsComplete ? null : "disabled")">
                                                        @child.FullName —
                                                        @Kr(portal.NextBookingTotalOreFor(child)) kr
                                                        @(child.IsComplete ? string.Empty : " (fyll i födelsedatum)")
                                                    </option>
                                                }
                                            </select>
                                            <button type="submit" class="btn-primary">Boka</button>
                                        }
                                    }
                                    }

                                    @if (portal.UnspentCredits > 0)
                                    {
                                        using (Html.BeginUmbracoForm<BookingSurfaceController>(
                                            nameof(BookingSurfaceController.Book), null,
                                            new { @class = "class-list__credit" }))
                                        {
                                            <input type="hidden" name="classKey" value="@bookable.Class.Key" />
                                            <input type="hidden" name="useCredit" value="true" />

                                            @if (choices.Length == 1)
                                            {
                                                <input type="hidden" name="participantKey" value="@choices[0].Key" />
                                            }
                                            else
                                            {
                                                <label class="visually-hidden" for="credit-child-@bookable.Class.Key">
                                                    Välj barn
                                                </label>
                                                <select id="credit-child-@bookable.Class.Key" name="participantKey"
                                                        class="class-list__child-picker">
                                                    @foreach (var child in choices)
                                                    {
                                                        <option value="@child.Key"
                                                                disabled="@(child.IsComplete ? null : "disabled")">
                                                            @child.FullName
                                                        </option>
                                                    }
                                                </select>
                                            }

                                            @* Secondary, not a link: it is an equal alternative to
                                               paying, so it should look like a choice rather than a
                                               footnote - just not competing with the yellow.

                                               Names the child when there is only one left to book,
                                               the same way the paying button does. On a family
                                               account with one sibling already on the class, an
                                               unqualified "Boka tillgodoträning" leaves the
                                               member to work out who it would apply to. *@
                                            <button type="submit" class="btn-secondary">
                                                @if (choices.Length == 1)
                                                {
                                                    <text>Boka tillgodoträning för @choices[0].FirstName</text>
                                                }
                                                else
                                                {
                                                    <text>Boka tillgodoträning</text>
                                                }
                                            </button>
                                        }
                                    }
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </article>
    }
</div>

@* Opens the coach profiles rendered by the InstructorName partial - both in the class list above
   and in Mina bokningar. One tag for the whole page: the script listens on the document rather
   than binding each button. *@
<script src="~/static/js/coach-dialog.js" defer></script>
