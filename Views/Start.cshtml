@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Root.cshtml";
    var blocks = Model.Value<BlockListModel>("contentBlocks");
}

<div class="content-blocks">
    @foreach (var block in blocks ?? Enumerable.Empty<BlockListItem>())
    {
        @* PascalCased to match the partial filenames - see the comment at the same call in
           Root.cshtml for why the casing is not optional. *@
        @await Html.PartialAsync($"blocklist/Components/{block.Content.ContentType.Alias.ToFirstUpperInvariant()}", block)
    }
</div>