@using NDSTK.Booking.Web
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Root.cshtml";

    // Set by MemberVerifyController, which Umbraco routes this document type through.
    var outcome = ViewData["VerifyOutcome"] as string ?? VerifyOutcome.Invalid;

    var loginPage = Model.Root()?.ChildrenOfType("login").FirstOrDefault();
}

<div class="content-blocks">
    <section class="hero">
        <div class="hero-content">
            <h1>@(Model.Value<string>("heading").IfNullOrWhiteSpace(Model.Name))</h1>
        </div>
    </section>

    <article class="post">
        @switch (outcome)
        {
            @* One message for both, deliberately. The two outcomes differ only in whether this
               request or an earlier one did the activating, and an earlier one is usually a mail
               client: Outlook and Gmail fetch the links in a message to scan them, so the member
               clicks and is told their account was "redan aktiverat" - by something they never
               saw. That reads as though somebody else opened their link. The member needs to know
               the account works and where to log in; which request switched it on is ours to know
               and theirs to be spared. The outcomes stay separate in the controller, where the
               distinction is real and worth logging. *@
            case VerifyOutcome.Confirmed:
            case VerifyOutcome.AlreadyDone:
                <p class="form-notice form-notice--ok" role="status">
                    Tack! Ditt konto är aktiverat.
                </p>
                <p>Nu kan du logga in och boka träningar.</p>
                break;

            default:
                <p class="form-notice form-notice--error" role="alert">
                    Länken fungerade inte. Den kan ha gått ut eller redan använts.
                </p>
                <p>
                    Registrera dig igen för att få en ny länk, eller kontakta oss på
                    <a href="mailto:info@@ndstk.se">info@@ndstk.se</a> om det fortsätter strula.
                </p>
                break;
        }

        @if (loginPage is not null && outcome != VerifyOutcome.Invalid)
        {
            <p><a href="@loginPage.Url()" class="btn-primary">Logga in</a></p>
        }
    </article>
</div>