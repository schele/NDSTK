@using NDSTK.Booking.Web
@using Umbraco.Cms.Core.Security
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IMemberManager MemberManager
@{
    Layout = "Root.cshtml";

    var isLoggedIn = MemberManager.IsLoggedIn();
    var registerPage = Model.Root()?.ChildrenOfType("memberRegister").FirstOrDefault();
}

<div class="content-blocks">
    <section class="hero">
        <div class="hero-content">
            <h1>@(Model.Value<string>("heading").IfNullOrWhiteSpace(Model.Name))</h1>
            <p>@(Model.Value<string>("description"))</p>
        </div>
    </section>

    <article class="post">
        @if (isLoggedIn)
        {
            <p class="form-notice form-notice--ok" role="status">Du är redan inloggad.</p>
        }
        else
        {
            <div class="member-form">
                @using (Html.BeginUmbracoForm<LoginSurfaceController>(nameof(LoginSurfaceController.Login)))
                {
                    <div asp-validation-summary="ModelOnly" class="form-notice form-notice--error"></div>

                    <div class="form-field">
                        <label for="Email">E-postadress</label>
                        <input type="email" id="Email" name="Email" autocomplete="username" required />
                        <span class="form-error">@Html.ValidationMessage("Email")</span>
                    </div>

                    <div class="form-field">
                        <label for="Password">Lösenord</label>
                        <input type="password" id="Password" name="Password"
                               autocomplete="current-password" required />
                        <span class="form-error">@Html.ValidationMessage("Password")</span>
                    </div>

                    <div class="form-field form-field--check">
                        <label>
                            <input type="checkbox" name="RememberMe" value="true" />
                            Håll mig inloggad
                        </label>
                    </div>

                    <p><button type="submit" class="btn-primary">Logga in</button></p>
                }

                @if (registerPage is not null)
                {
                    <p class="form-hint">
                        Inget konto än? <a href="@registerPage.Url()">Bli medlem</a>.
                    </p>
                }
            </div>
        }

        @if (string.IsNullOrWhiteSpace(Model.Value<string>("subText")) is false)
        {
            <p class="form-hint">@(Model.Value<string>("subText"))</p>
        }
    </article>
</div>
