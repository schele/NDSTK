@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Services
@using Umbraco.Cms.Core.Web
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@inject ILanguageService LanguageService
@inject IUmbracoContextAccessor UmbracoContextAccessor
@inject Umbraco.Cms.Core.Security.IMemberManager MemberManager

@{
    var umbracoContext = UmbracoContextAccessor.GetRequiredUmbracoContext();
    var currentCulture = umbracoContext.PublishedRequest?.Culture;
    var currentPage = umbracoContext.PublishedRequest?.PublishedContent;

    // A language only belongs in the switcher once this page can actually be reached in it.
    // Umbraco hands back "#" for a culture with no route - no domain bound, or invariant content -
    // and an option pointing at "#" would just be a dead end.
    var languages = (await LanguageService.GetAllAsync())
        .Select(language => new { language.IsoCode, Url = currentPage?.Url(language.IsoCode) })
        .Where(language => string.IsNullOrEmpty(language.Url) is false && language.Url != "#")
        .ToList();

    var root = Model?.Root() ?? Umbraco.ContentAtRoot().FirstOrDefault();
    var settings = root?.ChildrenOfType("settings").FirstOrDefault();

    var siteName = settings?.Value<string>("siteName").IfNullOrWhiteSpace("NDSTK");
    var footerText = settings?.Value<string>("footerText")
        .IfNullOrWhiteSpace($"© {DateTime.UtcNow.Year} NDSTK Tennis Club — Serve. Volley. Repeat.");
    var menu = settings?.Value<IEnumerable<IPublishedContent>>("menu") ?? [];
    var loginPage = settings?.Value<IPublishedContent>("loginPage");
    var widgets = settings?.Value<BlockListModel>("sidebarWidgets");

    // The package resolves its own policy page internally, but that resolver is package-internal,
    // so the footer link below does its own by-type lookup. DescendantsOfType comes from
    // FriendlyPublishedContentExtensions, which resolves the navigation and published-status
    // services itself - nothing needs injecting here, exactly as ChildrenOfType above.
    var cookiePage = Umbraco.ContentAtRoot()
        .SelectMany(node => node.DescendantsOfType("cookiePolicy"))
        .FirstOrDefault(page => page.IsPublished());

    var metaTitle = Model?.Value<string>("metaTitle").IfNullOrWhiteSpace(Model?.Name).IfNullOrWhiteSpace(siteName);
    var metaDescription = Model?.Value<string>("metaDescription");
    var metaAuthor = Model?.Value<string>("metaAuthor");
    var metaRobots = Model?.Value<string>("metaRobots").IfNullOrWhiteSpace("INDEX,FOLLOW");
    var metaKeywords = string.Join(",", Model?.Value<IEnumerable<string>>("metaKeywords") ?? []);
}

<!DOCTYPE html>
<html lang="@(currentCulture ?? "sv")">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@metaDescription" />
    <meta name="keywords" content="@metaKeywords" />
    <meta name="robots" content="@metaRobots" />
    <meta name="author" content="@metaAuthor" />
    <title>@metaTitle</title>
    <link href="~/static/css/site.css" rel="stylesheet" />
    <consent-head />
    @* After <consent-head /> deliberately. The package themes through --consent-* custom
       properties declared on :root, so an override of equal specificity only wins by being
       declared later - putting this link first would silently lose every token. *@
    <link href="~/static/css/consent-overrides.css" rel="stylesheet" />
</head>
<body>
    @* First in <body> so the dialog is reachable in DOM tab order. *@
    <consent-banner />

    <header>
        <div class="header-container">
            <div class="logo">
                <a href="@(root?.Url() ?? "/")"><img src="~/static/img/ndstk-logo.png" alt="@siteName" /></a>
            </div>
            <nav>
                <ul>
                    <li><a href="/umbraco" target="_blank">backoffice</a></li>
                    @if (languages.Count > 1)
                    {
                        <li>
                            <select class="language-selector" onchange="window.location.href=this.value">
                                @foreach (var language in languages)
                                {
                                    <option value="@language.Url" selected="@(currentCulture == language.IsoCode)">@language.IsoCode.ToUpperInvariant()</option>
                                }
                            </select>
                        </li>
                    }
                    @foreach (var item in menu)
                    {
                        <li><a href="@item.Url()" title="@item.Name">@item.Name?.ToUpperInvariant()</a></li>
                    }
                </ul>
            </nav>
        </div>
    </header>

    <main class="container">
        @* Left column - the page's own content *@
        @RenderBody()

        @* Right column - site-wide widgets, configured on the Settings node *@
        <aside>
            @{
                var isMemberLoggedIn = MemberManager.IsLoggedIn();
                var portalPage = settings?.Value<IPublishedContent>("memberPortalPage");
            }
            @* A page may take the sidebar over entirely - the member portal does, to put the
               member's own membership and bookings there instead of the generic boxes. *@
            @if (IsSectionDefined("Sidebar"))
            {
                @await RenderSectionAsync("Sidebar")
            }
            else if (isMemberLoggedIn)
            {
                <div class="widget widget--highlight">
                    <h3>Medlem</h3>
                    @if (portalPage is not null)
                    {
                        <p><a href="@portalPage.Url()" class="btn-primary">Mina sidor</a></p>
                    }
                    @* No sign-out here on purpose. This box appears on every page of the site, and
                       signing out is not something a member wants within reach while reading an
                       article. It lives on Mina sidor, at the bottom, where managing the account is
                       what you came for. *@
                </div>
            }
            else if (loginPage is not null)
            {
                <div class="widget widget--highlight">
                    <h3>Medlem</h3>
                    <p><a href="@loginPage.Url()" class="btn-primary">Logga in</a></p>
                </div>
            }
            @* Skipped when a page supplies its own sidebar, so the portal does not carry a
               "Bli medlem" call to action aimed at somebody who is already a member. *@
            @if (IsSectionDefined("Sidebar") is false)
            {
                foreach (var widget in widgets ?? Enumerable.Empty<BlockListItem>())
                {
                    @await Html.PartialAsync($"blocklist/Components/{widget.Content.ContentType.Alias}", widget)
                }
            }
        </aside>
    </main>

    <footer>
        <p>@footerText</p>
        <p>
            <button type="button" class="consent-btn consent-btn--link" data-consent-open>@(Umbraco.GetDictionaryValueOrDefault("Cookies.Footer.Link", "Cookieinställningar"))</button>
            @if (cookiePage is not null)
            {
                <a href="@cookiePage.Url()">@cookiePage.Name</a>
            }
        </p>
    </footer>
</body>
</html>