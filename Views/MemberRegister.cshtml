@using NDSTK.Booking.Web
@using NDSTK.Booking.Security
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IdentityErrorMessages PasswordRules
@{
    Layout = "Root.cshtml";
    var message = TempData["RegisterMessage"] as string;
}

<div class="content-blocks">
    <section class="hero">
        <div class="hero-content">
            <h1>@(Model.Value<string>("heading").IfNullOrWhiteSpace(Model.Name))</h1>
            <p>@(Model.Value<string>("description"))</p>
        </div>
    </section>

    <article class="post">
        @if (string.IsNullOrWhiteSpace(message) is false)
        {
            @* Shown after any submission that is not a validation failure - including an address
               that is already registered, which must be indistinguishable from success. *@
            <p class="form-notice form-notice--ok" role="status">@message</p>
        }
        else
        {
            <div class="member-form">
                @using (Html.BeginUmbracoForm<RegisterSurfaceController>(nameof(RegisterSurfaceController.Register)))
                {
                    <div asp-validation-summary="ModelOnly" class="form-notice form-notice--error"></div>

                    @* Two named groups, because the form now asks for two people's names and
                       "Förnamn" twice with nothing between them is a form people fill in wrongly. *@
                    <fieldset class="form-group">
                        <legend>Du</legend>

                        <div class="form-field">
                            <label for="FirstName">Förnamn</label>
                            <input type="text" id="FirstName" name="FirstName" autocomplete="given-name"
                                   maxlength="100" required
                                   value="@(ViewData["FirstName"] ?? string.Empty)" />
                            <span class="form-error">@Html.ValidationMessage("FirstName")</span>
                        </div>

                        <div class="form-field">
                            <label for="LastName">Efternamn</label>
                            <input type="text" id="LastName" name="LastName" autocomplete="family-name"
                                   maxlength="100" required
                                   value="@(ViewData["LastName"] ?? string.Empty)" />
                            <span class="form-error">@Html.ValidationMessage("LastName")</span>
                        </div>

                        <div class="form-field">
                            <label for="Email">E-postadress</label>
                            <input type="email" id="Email" name="Email" autocomplete="email" required
                                   value="@(ViewData["Email"] ?? string.Empty)" />
                            <span class="form-error">@Html.ValidationMessage("Email")</span>
                        </div>

                        <div class="form-field">
                            <label for="Phone">Telefon</label>
                            <input type="tel" id="Phone" name="Phone" autocomplete="tel"
                                   maxlength="30" required
                                   value="@(ViewData["Phone"] ?? string.Empty)" />
                            <span class="form-hint">Så att tränaren kan nå dig om något ändras.</span>
                            <span class="form-error">@Html.ValidationMessage("Phone")</span>
                        </div>
                    </fieldset>

                    <fieldset class="form-group">
                        <legend>Barnet</legend>

                        <div class="form-field">
                            <label for="ChildFirstName">Förnamn</label>
                            <input type="text" id="ChildFirstName" name="ChildFirstName"
                                   maxlength="100" required
                                   value="@(ViewData["ChildFirstName"] ?? string.Empty)" />
                            <span class="form-error">@Html.ValidationMessage("ChildFirstName")</span>
                        </div>

                        <div class="form-field">
                            <label for="ChildLastName">Efternamn</label>
                            <input type="text" id="ChildLastName" name="ChildLastName"
                                   maxlength="100" required
                                   value="@(ViewData["ChildLastName"] ?? string.Empty)" />
                            <span class="form-error">@Html.ValidationMessage("ChildLastName")</span>
                        </div>

                        <div class="form-field">
                            <label for="ChildBirthDate">Födelsedatum</label>
                            @* Eight digits only. We do not ask for, or store, a personnummer. *@
                            <input type="text" id="ChildBirthDate" name="ChildBirthDate"
                                   inputmode="numeric" pattern="\d{8}" maxlength="8"
                                   placeholder="ÅÅÅÅMMDD" required
                                   aria-describedby="birthdate-hint"
                                   value="@(ViewData["ChildBirthDate"] ?? string.Empty)" />
                            <span class="form-hint" id="birthdate-hint">
                                Åtta siffror, till exempel 20170413. Vi frågar inte efter personnummer.
                            </span>
                            <span class="form-error">@Html.ValidationMessage("ChildBirthDate")</span>
                        </div>

                        <p class="form-hint">
                            Vill du anmäla flera barn lägger du till dem på Mina sidor efteråt.
                        </p>
                    </fieldset>

                    <div class="form-field">
                        <label for="Password">Lösenord</label>
                        <input type="password" id="Password" name="Password" autocomplete="new-password"
                               required aria-describedby="password-rules" />
                        @* Stated up front and read from the live configuration, so a member is not
                           told the rules only after being rejected by them. *@
                        <span class="form-hint" id="password-rules">@PasswordRules.PasswordRules()</span>
                        <span class="form-error">@Html.ValidationMessage("Password")</span>
                    </div>

                    <div class="form-field">
                        <label for="ConfirmPassword">Upprepa lösenord</label>
                        <input type="password" id="ConfirmPassword" name="ConfirmPassword"
                               autocomplete="new-password" required />
                        <span class="form-error">@Html.ValidationMessage("ConfirmPassword")</span>
                    </div>

                    @* Honeypot. Hidden from people, left empty by them, and filled in by a bot that
                       completes every input. aria-hidden and tabindex keep it away from screen
                       readers and keyboard navigation, so it is invisible to real users too. *@
                    <div class="form-honeypot" aria-hidden="true">
                        <label for="Website">Webbplats</label>
                        <input type="text" id="Website" name="Website" tabindex="-1" autocomplete="off" />
                    </div>

                    <input type="hidden" name="RenderedAt" value="@DateTimeOffset.UtcNow.ToUnixTimeSeconds()" />

                    <p><button type="submit" class="btn-primary">Skapa konto</button></p>
                    @* The lifespan is read from the token provider's options rather than typed in,
                       so this sentence cannot promise a different number from the one Identity
                       enforces. *@
                    <p class="form-hint">
                        Du får ett mail med en länk som aktiverar kontot. Länken gäller i
                        @((int)MemberVerificationTokenOptions.Lifespan.TotalMinutes) minuter.
                        Kontrollera skräpposten om det inte kommer fram.
                    </p>
                }
            </div>
        }
    </article>
</div>