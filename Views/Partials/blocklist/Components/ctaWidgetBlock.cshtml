@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@{
    var content = Model.Content;
    var heading = content.Value<string>("heading");
    var text = content.Value<string>("text");
    var link = content.Value<IEnumerable<Umbraco.Cms.Core.Models.Link>>("link")?.FirstOrDefault();
    var highlight = content.Value<bool>("highlight");
}

<div class="widget @(highlight ? "widget--highlight" : null)">
    @if (!string.IsNullOrWhiteSpace(heading))
    {
        <h3>@heading</h3>
    }
    @if (!string.IsNullOrWhiteSpace(text))
    {
        <p>@text</p>
    }
    @if (link is not null && !string.IsNullOrWhiteSpace(link.Url))
    {
        <p><a href="@link.Url" target="@link.Target" class="btn-primary">@link.Name</a></p>
    }
</div>
