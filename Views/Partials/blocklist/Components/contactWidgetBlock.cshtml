@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@{
    var content = Model.Content;
    var heading = content.Value<string>("heading");
    var email = content.Value<string>("email");
    var phone = content.Value<string>("phone");
}

<div class="widget">
    @if (!string.IsNullOrWhiteSpace(heading))
    {
        <h3>@heading</h3>
    }
    @if (!string.IsNullOrWhiteSpace(email))
    {
        <p>E-post: <a href="mailto:@email" class="email">@email</a></p>
    }
    @if (!string.IsNullOrWhiteSpace(phone))
    {
        @* The label keeps the editor's spacing and dashes, because that is how a Swedish number is
           read. The href does not: a tel: URI may only carry digits and a leading +, so spaces and
           dashes are stripped rather than passed through and left for the phone to guess at. *@
        var dialable = new string([.. phone.Where(c => char.IsDigit(c) || c == '+')]);

        <p>Telefon: <a href="tel:@dialable" class="email">@phone</a></p>
    }
</div>
