@using Microsoft.Extensions.Options
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IConsentState Consent
@inject IOptions<ConsentOptions> ConsentSettings

@{
    var settings = ConsentSettings.Value;
    var settingsNode = Model?.Root()?.ChildrenOfType("settings").FirstOrDefault();
    var policyPage = settingsNode?.Value<IPublishedContent>("cookiePolicyPage");
    var granted = Consent.Decision?.Granted ?? new HashSet<ConsentCategory>();
    var needsDecision = Consent.NeedsDecision;

    // Cookies declared per category, feeding the <details> that spec §10 requires inside each
    // fieldset ("so people can inspect without navigating away"). Every step of this chain can be
    // absent right now - no cookiePolicyPage property on Settings yet, no page picked once it exists,
    // no cookies block on that page, an unparsable category value on a block - so this must degrade to
    // "no cookies for this category" rather than throw or log.
    var cookiesByCategory = ConsentCategories.All.ToDictionary(
        category => category,
        _ => new List<(string Name, string Provider, string Purpose, string Duration, string StorageType)>());

    var cookieBlocks = policyPage?.Value<BlockListModel>("cookies");
    if (cookieBlocks is not null)
    {
        foreach (BlockListItem block in cookieBlocks)
        {
            var wireCategory = block.Content.Value<string>("category");
            if (ConsentCategories.TryParse(wireCategory, out var parsedCategory))
            {
                var cookieName = block.Content.Value<string>("cookieName");
                if (string.IsNullOrWhiteSpace(cookieName) is false)
                {
                    cookiesByCategory[parsedCategory].Add((
                        cookieName,
                        block.Content.Value<string>("provider") ?? string.Empty,
                        block.Content.Value<string>("purpose") ?? string.Empty,
                        block.Content.Value<string>("duration") ?? string.Empty,
                        block.Content.Value<string>("storageType") ?? string.Empty));
                }
            }
        }
    }
}

<dialog id="consent-dialog" class="consent-dialog" aria-labelledby="consent-dialog-heading">
    <div class="consent-dialog__body">
        <h2 id="consent-dialog-heading">@(Umbraco.GetDictionaryValueOrDefault("Cookies.Banner.Heading", "Vi använder kakor"))</h2>
        <p>@(Umbraco.GetDictionaryValueOrDefault("Cookies.Banner.Body", string.Empty))</p>

        @foreach (var category in ConsentCategories.All)
        {
            var wire = ConsentCategories.ToWireName(category);
            var isNecessary = category == ConsentCategory.Necessary;
            var inputId = $"consent-cat-{wire}";
            var categoryCookies = cookiesByCategory[category];
            <fieldset class="consent-category">
                <legend>@(Umbraco.GetDictionaryValueOrDefault($"Cookies.Category.{category}.Name", wire))</legend>
                <div class="consent-category__row">
                    <input type="checkbox"
                           id="@inputId"
                           value="@wire"
                           data-consent-category-input
                           checked="@(isNecessary || granted.Contains(category))"
                           disabled="@isNecessary" />
                    <label for="@inputId">
                        @(Umbraco.GetDictionaryValueOrDefault($"Cookies.Category.{category}.Description", string.Empty))
                    </label>
                </div>
                @if (categoryCookies.Count > 0)
                {
                    <details class="consent-category__cookies">
                        <summary>@(Umbraco.GetDictionaryValueOrDefault("Cookies.Category.Cookies", "Kakor i den här kategorin"))</summary>
                        @foreach (var cookie in categoryCookies)
                        {
                            <dl class="consent-cookie">
                                <dt>@(Umbraco.GetDictionaryValueOrDefault("Cookies.Table.Name", "Namn"))</dt>
                                <dd>@cookie.Name</dd>
                                @if (string.IsNullOrWhiteSpace(cookie.Provider) is false)
                                {
                                    <dt>@(Umbraco.GetDictionaryValueOrDefault("Cookies.Table.Provider", "Leverantör"))</dt>
                                    <dd>@cookie.Provider</dd>
                                }
                                @if (string.IsNullOrWhiteSpace(cookie.Purpose) is false)
                                {
                                    <dt>@(Umbraco.GetDictionaryValueOrDefault("Cookies.Table.Purpose", "Syfte"))</dt>
                                    <dd>@cookie.Purpose</dd>
                                }
                                @if (string.IsNullOrWhiteSpace(cookie.Duration) is false)
                                {
                                    <dt>@(Umbraco.GetDictionaryValueOrDefault("Cookies.Table.Duration", "Lagringstid"))</dt>
                                    <dd>@cookie.Duration</dd>
                                }
                                @if (string.IsNullOrWhiteSpace(cookie.StorageType) is false)
                                {
                                    <dt>@(Umbraco.GetDictionaryValueOrDefault("Cookies.Table.Type", "Typ"))</dt>
                                    <dd>@cookie.StorageType</dd>
                                }
                            </dl>
                        }
                    </details>
                }
            </fieldset>
        }

        <p class="consent-status" role="status" aria-live="polite" hidden data-consent-status></p>

        <div class="consent-dialog__actions">
            <button type="button" class="btn-primary" data-consent-action="accept-all">@(Umbraco.GetDictionaryValueOrDefault("Cookies.Banner.AcceptAll", "Godkänn alla"))</button>
            @* Reject shares accept's class deliberately: identical treatment, distinguished only by
               label, so neither option is nudged. *@
            <button type="button" class="btn-primary" data-consent-action="reject-all">@(Umbraco.GetDictionaryValueOrDefault("Cookies.Banner.RejectAll", "Neka alla"))</button>
            <button type="button" class="btn-outline" data-consent-action="custom">@(Umbraco.GetDictionaryValueOrDefault("Cookies.Banner.Save", "Spara val"))</button>
            @if (needsDecision is false)
            {
                <button type="button" class="btn-outline" data-consent-close>@(Umbraco.GetDictionaryValueOrDefault("Cookies.Banner.Cancel", "Avbryt"))</button>
            }
        </div>
    </div>
</dialog>

<script src="~/static/js/consent.js" defer
        data-consent-endpoint="/api/consent"
        data-consent-cookie="@settings.CookieName"
        data-consent-version="@settings.PolicyVersion"
        data-consent-mode="@(string.IsNullOrWhiteSpace(settings.GoogleMeasurementId) ? "off" : "on")"
        data-consent-needs-decision="@(needsDecision ? "true" : "false")"
        data-consent-error-message="@(Umbraco.GetDictionaryValueOrDefault("Cookies.Banner.Error", "Något gick fel. Försök igen."))"
        data-consent-rate-limited-message="@(Umbraco.GetDictionaryValueOrDefault("Cookies.Banner.RateLimited", "Du har försökt för många gånger. Vänta en stund och försök igen."))"></script>
