@using NDSTK.Booking.Domain
@using NDSTK.Booking.Web
@model MemberBookingsPanel
@{
    var culture = new System.Globalization.CultureInfo("sv-SE");
    string When(DateTime utc) => SwedishTime.ToSwedish(utc).ToString("dddd d MMMM HH:mm", culture);

    // Öre to kronor, in the one place this partial needs it - the same conversion the portal does,
    // and the only arithmetic on money that happens outside MembershipSettingsService.
    string Kr(int ore) => (ore / 100).ToString("N0", culture);
}

@* Shared by the member portal and the payment page, so the two cannot show different bookings. *@
<div class="widget">
    <h3>Mina bokningar</h3>

    @if (Model.Rows.Count == 0)
    {
        @* The box still renders when empty. A member who has just paid should see where their
           bookings will appear, rather than the box vanishing and reappearing. *@
        <p>Inga bokningar.</p>
    }
    else
    {
        <ul class="booking-list booking-list--stacked">
            @foreach (var row in Model.Rows)
            {
                <li class="booking-list__item">
                    <span class="booking-list__title">@(row.Class?.Title ?? "Träning")</span>
                    @* Whose place this is. Without it a family account shows two identical rows for
                       the same class and no way to tell which child each one belongs to. *@
                    @if (row.ChildName is { Length: > 0 } child)
                    {
                        <span class="booking-list__child">@child</span>
                    }
                    <span class="booking-list__when">@When(row.ClassStartUtc)</span>

                    @* The practical details - how long, who is coaching, which court - belong on the
                       booking a member is about to turn up for, not on a class-list row they have
                       finished with. Null when an editor has deleted the class; the booking still
                       renders from its own copy of the start time. *@
                    @if (row.Class is { } detail)
                    {
                        <span class="booking-list__where">
                            @detail.DurationMinutes min
                            @if (detail.Instructor is { } coach)
                            {
                                <text>· </text>
                                @await Html.PartialAsync("InstructorName", coach)
                            }
                            @if (detail.Location is { Length: > 0 })
                            {
                                <text>· </text>
                                @await Html.PartialAsync("ClassLocation", detail)
                            }
                        </span>
                    }
                    <span class="booking-list__tags">
                        @* What this place cost, so the list doubles as a receipt.

                           The two are not exclusive: a lapsed member spending a credit pays the
                           annual fee and nothing for the class, so both labels are true and both
                           appear. A paid-up member spending one owes nothing at all, and gets only
                           the credit label because no payment exists. *@
                        @if (row.UsedCredit)
                        {
                            <span class="tag tag--label">Tillgodoträning</span>
                        }
                        @if (row.PaidOre is { } paidOre)
                        {
                            <span class="tag tag--label">Betald @Kr(paidOre) kr</span>
                        }
                        else if (row.UsedCredit is false)
                        {
                            @* Confirmed but nothing recorded against it - a comped place, or a
                               booking from before payments were tracked. Better to say so than to
                               imply it was free. *@
                            <span class="tag tag--label">Ingen betalning registrerad</span>
                        }
                        @if (row.Class is null)
                        {
                            <span class="tag tag--label">Borttagen</span>
                        }
                        @if (Model.IsPastCancellationDeadline(row))
                        {
                            @* Shown disabled rather than removed. A button that vanishes leaves a
                               member wondering whether they missed it; one that is visibly closed,
                               with the reason on it, tells them the rule for next time. *@
                            <button type="submit" class="btn-danger btn--small" disabled
                                    title="Avbokning stänger @Model.CancellationDeadlineHours timmar före start">
                                Avboka
                            </button>
                        }
                        else if (Model.CanCancel(row))
                        {
                            using (Html.BeginUmbracoForm<BookingSurfaceController>(
                                nameof(BookingSurfaceController.Cancel)))
                            {
                                <input type="hidden" name="bookingId" value="@row.BookingId" />
                                @* The consequence is on the button itself: a member should not have
                                   to discover the no-refund rule afterwards. *@
                                <button type="submit" class="btn-danger btn--small"
                                        title="Avgiften betalas inte tillbaka, men du får en tillgodoträning">
                                    Avboka
                                </button>
                            }
                        }
                    </span>
                </li>
            }
        </ul>

        @* Stated once under the list rather than on each row, and in the open rather than only in
           the button's tooltip - a member finding out about the deadline from a greyed-out button
           has already missed it. Only where cancelling is possible at all: on the payment page the
           buttons are not rendered, so the rule would be describing something not on offer.

           The hours come from the same setting the button and the repository's WHERE clause use, so
           the sentence cannot promise a deadline the server would disagree with. *@
        @if (Model.AllowCancel)
        {
            <p class="form-hint">
                Avbokning stänger @Model.CancellationDeadlineHours timmar före start. Avgiften
                betalas inte tillbaka, men du får en tillgodoträning att använda till en annan
                träning.
            </p>
        }
    }
</div>
